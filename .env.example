PORT=3000
# Public URL, used for links in emails (invite / reset password)
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/specly

# First-run admin (only used when the users table is empty)
ADMIN_EMAIL=admin@specly.local
ADMIN_PASSWORD=NewPass123

# Email. Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Specly <no-reply@specly.local>

# Set to true when running behind a reverse proxy
TRUST_PROXY=false


member@specly.local	member	Specly1234
guest@specly.local	guest	Specly1234