PORT=3000
# Public URL, used for links in emails (invite / reset password)
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/specly

# First-run admin (only used when the users table is empty)
ADMIN_EMAIL=admin@specly.local
# Leave ADMIN_PASSWORD empty to get a generated password printed once; in production it must be 12+ characters.
ADMIN_PASSWORD=

# Email. Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Specly <no-reply@specly.local>

# Emails about access requests/assignments (invitations and password resets are always sent)
NOTIFY_EMAILS=true

# Onboarding: `npm run migrate` then `npm run seed` (the server also does both on a first start).
# AUTO_MIGRATE=true             # false: refuse to start while migrations are pending (run `npm run migrate` yourself)
# AUTO_SEED=true                # false: do not create the admin and a sample blueprint on a first start
# DEMO_PASSWORD=                # `npm run seed -- --demo`: one password for both demo accounts (default: generated)

# Encrypts two-factor secrets in the database. Required in production, 32+ characters: openssl rand -base64 32
APP_SECRET=

# Sessions end after this many idle hours (0 = never); items in the trash are removed for good after this many days (0 = never)
# SESSION_IDLE_HOURS=24
# TRASH_RETENTION_DAYS=30
# Password hashing cost (4-15). 12 is the default; raise it as hardware gets faster.
# BCRYPT_COST=12

# Set to true when running behind a reverse proxy
TRUST_PROXY=false

# Database tuning (all optional; shown with their defaults)
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_CONNECT_TIMEOUT_MS=5000
# DATABASE_SSL=false            # true for most managed Postgres services
# LOG_LEVEL=info                # error | warn | info | debug | silent
# LOG_FORMAT=pretty             # json (default in production) or pretty
# SLOW_REQUEST_MS=1000          # slower requests are logged as warnings (0 = off)
# SLOW_QUERY_MS=500             # so are slower database queries (0 = off)
# AUDIT_STORE=important         # which events the audit TABLE keeps: important | all (everything is logged either way)
# AUDIT_RETENTION_DAYS=0        # delete stored audit rows older than this many days (0 = keep forever)

# Production (NODE_ENV=production) refuses to start without BASE_URL, DATABASE_URL and SMTP_HOST.