{
  "name": "specly",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/e2e.test.js test/viewer.test.js test/browser.test.js",
    "start": "node server.js",
    "build:css": "tailwindcss -i src/input.css -o public/app.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o public/app.css --watch",
    "prestart": "npm run build:css",
    "dev": "npm run build:css && node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:new": "node scripts/migrate.js new",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "screenshots": "node scripts/screenshots.js",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API documentation portal for OpenAPI/Swagger blueprints",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "marked": "^18.1.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.35.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
