{
  "name": "specly",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/",
    "start": "node server.js",
    "reset-admin": "node scripts/reset-admin.js",
    "build:css": "tailwindcss -i src/input.css -o public/app.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o public/app.css --watch",
    "prestart": "npm run build:css",
    "dev": "npm run build:css && node --watch server.js",
    "seed": "node scripts/seed.js",
    "seed:users": "node scripts/seed-users.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API documentation portal for OpenAPI/Swagger blueprints",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "marked": "^18.1.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "swagger-ui-dist": "^5.34.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3"
  }
