<%- include('partials/head') %>
<div class="card mx-auto mt-10 max-w-sm sm:mt-20">
  <h1 class="text-xl font-bold">Two-factor sign-in</h1>
  <p class="mb-4 mt-1 text-sm text-slate-600 dark:text-slate-400">Enter the 6-digit code from your authenticator app for <strong><%= email %></strong>. Lost your phone? Use one of your recovery codes instead.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login/2fa"><%- include('partials/csrf') %>
    <label class="label">Code
      <input class="field font-mono tracking-widest" name="code" inputmode="numeric" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" required autofocus placeholder="123456 or abcde-fghij">
    </label>
    <button class="btn w-full">Verify and sign in</button>
  </form>
  <p class="mt-4 text-center text-sm"><a class="link" href="/login">Start over</a></p>
</div>
<%- include('partials/foot') %>
