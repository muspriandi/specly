<%- include('partials/head') %>
<div class="card mx-auto mt-6 max-w-sm sm:mt-12">
  <h1 class="text-xl font-bold">Change password</h1>
  <p class="mb-4 mt-1 text-sm text-slate-600 dark:text-slate-400">Signed in as <%= user.email %>. Other devices will be signed out.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/account/password"><%- include('partials/csrf') %>
    <label class="label">Current password <input class="field" type="password" name="current" required autofocus autocomplete="current-password"></label>
    <label class="label">New password <input class="field" type="password" name="password" minlength="8" required autocomplete="new-password" aria-describedby="pw-hint"><span class="hint" id="pw-hint">At least 8 characters.</span></label>
    <label class="label">Confirm new password <input class="field" type="password" name="confirm" minlength="8" required autocomplete="new-password"></label>
    <div class="flex items-center gap-4"><button class="btn">Update password</button><a class="link" href="/">Cancel</a></div>
  </form>
</div>
<%- include('partials/foot') %>
