<%- include('partials/head') %>
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  <div class="min-w-0">
    <%- include('partials/crumbs', { items: shared ? [[bp.title, base], ['Changelog', null]] : [['All blueprints', '/'], [bp.title, base], ['Changelog', null]] }) %>
    <h1 class="text-2xl font-bold">What changed in <%= bp.title %></h1>
  </div>
  <a class="btn btn-sm btn-ghost" href="<%= base %>">Back to the docs</a>
</div>
<ol class="space-y-3">
  <% entries.forEach(function (v, i) {
    var d = v.diff, total = d.added.length + d.changed.length + d.removed.length + d.deprecated.length;
    var groups = [['Added', 'text-emerald-700 dark:text-emerald-400', '+', d.added], ['Changed', 'text-amber-700 dark:text-amber-400', '~', d.changed],
                  ['Removed', 'text-red-700 dark:text-red-400', '−', d.removed], ['Newly deprecated', 'text-slate-700 dark:text-slate-300', '!', d.deprecated]];
  %>
  <li class="card">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h2 class="font-semibold">Revision <%= v.version_no %><% if (v.version) { %> · v<%= String(v.version).replace(/^v/i, '') %><% } %></h2>
      <% if (pg.page === 1 && i === 0) { %><span class="badge badge-ok">current</span><% } %>
      <span class="text-xs text-slate-600 dark:text-slate-400"><%= fmt(v.created_at) %></span>
    </div>
    <% if (v.note) { %><p class="mt-1 text-sm"><%= v.note %></p><% } %>
    <% if (v.initial) { %><p class="mt-2 text-sm text-slate-600 dark:text-slate-400">First published version (<%= d.added.length %> endpoint<%= d.added.length === 1 ? '' : 's' %>).</p>
    <% } else if (!total) { %><p class="mt-2 text-sm text-slate-600 dark:text-slate-400">No endpoint changes (text or description only).</p>
    <% } else { %>
    <div class="mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <% groups.forEach(function (g) { if (g[3].length) { %>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wide <%= g[1] %>"><%= g[0] %> <span class="font-normal">(<%= g[3].length %>)</span></div>
        <ul class="mt-1 space-y-0.5 font-mono text-xs">
          <% g[3].slice(0, 8).forEach(function (k) { %><li class="truncate" title="<%= k %>"><%= g[2] %> <%= k %></li><% }) %>
          <% if (g[3].length > 8) { %><li><details><summary class="link cursor-pointer select-none font-sans">…and <%= g[3].length - 8 %> more</summary><ul class="mt-1 space-y-0.5"><% g[3].slice(8).forEach(function (k) { %><li class="truncate" title="<%= k %>"><%= g[2] %> <%= k %></li><% }) %></ul></details></li><% } %>
        </ul>
      </div>
      <% } }) %>
    </div>
    <% } %>
  </li>
  <% }) %>
</ol>
<%- include('partials/pager', { pg: pg }) %>
<%- include('partials/foot') %>
