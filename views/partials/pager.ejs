<%
  // Needs `pg` (from lib/paginate). Keeps every other query parameter (search, the other table's page, limit).
  var href = function (over) {
    var p = Object.assign({}, query, over), out = [];
    Object.keys(p).forEach(function (k) { if (p[k] !== '' && p[k] != null && !Array.isArray(p[k])) out.push(encodeURIComponent(k) + '=' + encodeURIComponent(p[k])); });
    return '?' + out.join('&');
  };
%>
<% if (pg.total > 0) { %>
<nav class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm" aria-label="Pagination">
  <span class="text-slate-600 dark:text-slate-400">Showing <%= pg.from %>–<%= pg.to %> of <%= pg.total %></span>
  <span class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400">Per page
    <% pg.sizes.forEach(function (n) { %><% if (n === pg.limit) { %><b class="rounded bg-slate-200 px-1.5 py-0.5 text-slate-900 dark:bg-slate-700 dark:text-slate-100" aria-current="true"><%= n %></b><% } else { %><a class="link px-1" href="<%= href({ limit: n, [pg.param]: 1 }) %>"><%= n %></a><% } %><% }) %>
  </span>
  <% if (pg.pages > 1) { %>
  <span class="flex items-center gap-3">
    <% if (pg.page > 1) { %><a class="link" rel="prev" href="<%= href({ [pg.param]: pg.page - 1 }) %>">← Previous</a><% } else { %><span class="text-slate-400">← Previous</span><% } %>
    <span class="text-slate-600 dark:text-slate-400">Page <%= pg.page %> of <%= pg.pages %></span>
    <% if (pg.page < pg.pages) { %><a class="link" rel="next" href="<%= href({ [pg.param]: pg.page + 1 }) %>">Next →</a><% } else { %><span class="text-slate-400">Next →</span><% } %>
  </span>
  <% } %>
</nav>
<% } %>
