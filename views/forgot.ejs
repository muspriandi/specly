<%- include('partials/head') %>
<div class="card mx-auto mt-10 max-w-sm sm:mt-20">
  <h1 class="text-xl font-bold">Forgot password</h1>
  <% if (typeof sent !== 'undefined') { %>
    <div class="alert-info mt-4">If an account exists for that email, a reset link is on its way.</div>
  <% } else { %>
    <p class="mb-4 mt-1 text-sm text-slate-600 dark:text-slate-400">Enter your email and we'll send you a link to reset your password.</p>
    <form method="post" action="/forgot"><%- include('partials/csrf') %>
      <label class="label">Email <input class="field" type="email" name="email" required autofocus autocomplete="email"></label>
      <button class="btn w-full">Send reset link</button>
    </form>
  <% } %>
  <p class="mt-4 text-center"><a class="link" href="/login">Back to sign in</a></p>
</div>
<%- include('partials/foot') %>
