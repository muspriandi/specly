<%- include('partials/head') %>
<div class="mx-auto mt-4 max-w-xl">
  <h1 class="text-2xl font-bold">Two-factor sign-in</h1>
  <p class="mb-4 mt-1 text-sm text-slate-600 dark:text-slate-400">Adds a 6-digit code from an authenticator app (Google Authenticator, 1Password, Authy…) to your password, so a stolen password alone is not enough. Recommended for admins.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert-error" role="alert"><%= error %></div><% } %>

  <% if (codes) { %>
  <section class="card" aria-labelledby="codes-h">
    <h2 id="codes-h" class="font-semibold">Save your recovery codes</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Each code works once if you lose your phone. They are shown only now: store them somewhere safe (a password manager).</p>
    <ul class="my-3 grid grid-cols-2 gap-2 rounded-lg bg-slate-100 p-3 font-mono text-sm dark:bg-slate-800"><% codes.forEach(function (c) { %><li><%= c %></li><% }) %></ul>
    <button type="button" class="btn btn-sm" data-copy="<%= codes.join('\n') %>">Copy all</button>
  </section>
  <% } %>

  <% if (enabled) { %>
  <section class="card mt-4" aria-labelledby="on-h">
    <h2 id="on-h" class="flex items-center gap-2 font-semibold">Status <span class="badge badge-ok">On</span></h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Turned on <%= fmt(since) %>. <%= remaining %> recovery code<%= remaining === 1 ? '' : 's' %> left<% if (remaining <= 2) { %> — <strong>generate new ones soon</strong><% } %>.</p>
    <form method="post" action="/account/2fa/recovery" class="mt-4 grid gap-1"><%- include('partials/csrf') %>
      <h3 class="text-sm font-semibold">New recovery codes</h3>
      <div class="grid gap-2 sm:grid-cols-2">
        <label class="label">Password<input class="field" type="password" name="password" required autocomplete="current-password"></label>
        <label class="label">Authenticator code<input class="field font-mono" name="code" inputmode="numeric" autocomplete="one-time-code" required></label>
      </div>
      <div><button class="btn btn-ghost">Generate new codes</button></div>
    </form>
    <form method="post" action="/account/2fa/disable" class="mt-4 grid gap-1 border-t border-slate-200 pt-4 dark:border-slate-700" data-confirm="You will sign in with just your password again." data-confirm-title="Turn off two-factor sign-in?" data-confirm-action="Turn off"><%- include('partials/csrf') %>
      <h3 class="text-sm font-semibold">Turn off</h3>
      <div class="grid gap-2 sm:grid-cols-2">
        <label class="label">Password<input class="field" type="password" name="password" required autocomplete="current-password"></label>
        <label class="label">Authenticator or recovery code<input class="field font-mono" name="code" required autocomplete="one-time-code"></label>
      </div>
      <div><button class="btn btn-ghost">Turn off two-factor</button></div>
    </form>
  </section>
  <% } else if (setup) { %>
  <section class="card" aria-labelledby="setup-h">
    <h2 id="setup-h" class="font-semibold">Set up</h2>
    <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm text-slate-700 dark:text-slate-300">
      <li>Open your authenticator app and add an account by scanning the QR code (or typing the key).</li>
      <li>Enter the 6-digit code it shows, below.</li>
    </ol>
    <div class="mt-3 flex flex-wrap items-center gap-4">
      <div class="size-48 shrink-0 rounded-lg border border-slate-200 bg-white p-2 [&>svg]:block [&>svg]:size-full" role="img" aria-label="QR code for your authenticator app"><%- setup.svg %></div>
      <div class="min-w-0 text-sm"><div class="text-slate-600 dark:text-slate-400">Can't scan? Enter this key:</div><code class="mt-1 block break-all rounded bg-slate-100 px-2 py-1 font-mono text-sm dark:bg-slate-800"><%= setup.secret %></code></div>
    </div>
    <form method="post" action="/account/2fa/enable" class="mt-4 flex flex-wrap items-end gap-2"><%- include('partials/csrf') %>
      <label class="label !mb-0">Code<input class="field font-mono tracking-widest sm:w-40" name="code" inputmode="numeric" autocomplete="one-time-code" required placeholder="123456"></label>
      <button class="btn">Turn on</button>
    </form>
  </section>
  <% } else { %>
  <section class="card">
    <h2 class="flex items-center gap-2 font-semibold">Status <span class="badge badge-neutral">Off</span></h2>
    <form method="post" action="/account/2fa/start" class="mt-3"><%- include('partials/csrf') %><button class="btn">Set up two-factor sign-in</button></form>
  </section>
  <% } %>
</div>
<%- include('partials/foot') %>
