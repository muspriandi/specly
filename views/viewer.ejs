<%- include('partials/head', { swagger: classic, wide: true }) %>
<div class="mb-3 flex flex-wrap items-center gap-3">
  <nav aria-label="Breadcrumb" class="flex min-w-0 flex-1 basis-64 items-center gap-2 text-sm"><a class="link shrink-0" href="/">All blueprints</a><span class="text-slate-400" aria-hidden="true">/</span><span class="min-w-0 truncate font-medium" title="<%= bp.title %>"><%= bp.title %></span></nav>
  <% if (bp.version) { %><span class="badge badge-neutral shrink-0">v<%= bp.version %></span><% } %>
  <div class="ml-auto flex shrink-0 items-center gap-3">
    <div class="inline-flex overflow-hidden rounded-lg border border-slate-300 text-xs font-medium dark:border-slate-700" role="group" aria-label="Viewer">
      <a class="px-3 py-1.5 <%= classic ? 'hover:bg-slate-100 dark:hover:bg-slate-800' : 'bg-brand-600 text-white' %>" href="/blueprints/<%= bp.id %>" <%- classic ? '' : 'aria-current="page"' %>>Collection</a>
      <a class="px-3 py-1.5 <%= classic ? 'bg-brand-600 text-white' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>" href="/blueprints/<%= bp.id %>?view=swagger" <%- classic ? 'aria-current="page"' : '' %>>Swagger UI</a>
    </div>
    <a class="btn btn-sm btn-ghost" href="/blueprints/<%= bp.id %>/source">Download <%= bp.format %></a>
  </div>
</div>
<% if (classic) { %>
<div id="swagger" data-spec="/blueprints/<%= bp.id %>/spec.json" class="rounded-xl bg-white py-2 text-slate-900"></div>
<script src="/static/swagger/swagger-ui-bundle.js"></script>
<script src="/static/viewer.js"></script>
<% } else { %>
<div id="doc" data-spec="/blueprints/<%= bp.id %>/spec.json"><div role="status" aria-label="Loading documentation" class="grid gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]"><div class="skeleton h-64"></div><div class="space-y-3"><div class="skeleton h-8 w-1/3"></div><div class="skeleton h-4 w-2/3"></div><div class="skeleton h-40"></div></div></div></div>
<script src="/static/vendor/marked/marked.umd.js"></script>
<script src="/static/vendor/dompurify/purify.min.js"></script>
<script src="/static/doc-model.js"></script>
<script src="/static/postman-view.js"></script>
<% } %>
<%- include('partials/foot') %>
