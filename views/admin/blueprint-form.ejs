<%- include('../partials/head', { wide: true }) %>
<nav aria-label="Breadcrumb" class="mb-3 text-sm text-slate-600 dark:text-slate-400"><a class="link" href="/manage/blueprints">Blueprints</a> <span aria-hidden="true">/</span> <span><%= bp ? 'Edit' : 'Add' %></span></nav>
<div class="card">
  <h1 class="min-w-0 truncate text-xl font-bold" <%- bp ? 'title="' + bp.title.replace(/"/g, '&quot;') + '"' : '' %>><%= bp ? 'Edit “' + bp.title + '”' : 'Add blueprint' %></h1>
  <p class="mb-4 mt-1 text-sm text-slate-600 dark:text-slate-400">Write or paste an OpenAPI 3.x / Swagger 2.0 document, or drop a file. Title and version come from <code>info</code>. Then preview, review the changes and <%= bp ? 'publish' : 'add it' %>.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" enctype="multipart/form-data" data-preview-render="/manage/blueprints/preview/render?_csrf=<%= csrfToken %>" data-preview="/manage/blueprints/preview<%= bp ? '?for=' + bp.id + '&' : '?' %>_csrf=<%= csrfToken %>" action="<%= bp ? '/manage/blueprints/' + bp.id : '/manage/blueprints' %>?_csrf=<%= csrfToken %>">
    <% if (bp && bp.revision) { %><input type="hidden" name="base" value="<%= bp.revision %>"><% } %>
    <% if (typeof conflict !== 'undefined' && conflict) { %>
    <div class="mb-4 rounded-lg border border-amber-500/50 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200" role="alert">
      <p><strong>Revision <%= conflict.revision %></strong> was saved<%= conflict.author ? ' by ' + conflict.author : '' %> at <%= fmt(conflict.at) %>, after you opened this page.
        <a class="link" href="/manage/blueprints/<%= bp.id %>/versions" target="_blank" rel="noopener">Review what changed</a> (opens in a new tab).</p>
      <label class="mt-2 flex items-center gap-2"><input type="checkbox" name="overwrite" value="1" class="size-4 accent-brand-600"> I have reviewed it and want to save my version on top.</label>
    </div>
    <% } %>
    <ol role="tablist" aria-label="Steps" class="-mx-5 mb-4 flex gap-1 overflow-x-auto border-b border-slate-200 px-5 dark:border-slate-700" data-views>
      <li role="presentation"><button type="button" role="tab" id="view-edit" aria-controls="vp-edit" aria-selected="true" class="view-tab"><span class="step-n" aria-hidden="true">1</span>Edit</button></li>
      <li role="presentation"><button type="button" role="tab" id="view-preview" aria-controls="vp-preview" aria-selected="false" tabindex="-1" class="view-tab"><span class="step-n" aria-hidden="true">2</span>Preview</button></li>
      <li role="presentation"><button type="button" role="tab" id="view-changes" aria-controls="vp-changes" aria-selected="false" tabindex="-1" class="view-tab"><span class="step-n" aria-hidden="true">3</span><%= bp ? 'Review changes' : 'Review' %> <span class="badge-count hidden" data-changes-count></span></button></li>
    </ol>

    <div id="vp-edit" role="tabpanel" aria-labelledby="view-edit">
      <div id="bp-preview" class="mb-4 hidden rounded-lg border px-4 py-2.5 text-sm" role="status" aria-live="polite"></div>
      <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border-2 border-dashed border-slate-300 px-4 py-3 text-sm text-slate-600 transition dark:border-slate-700 dark:text-slate-400" data-drop>
        <%- icon('file', 'size-5 shrink-0 text-slate-400') %>
        <span data-drop-label>Drop a <code>.yaml</code>, <code>.yml</code> or <code>.json</code> file here, or</span>
        <label class="btn btn-sm btn-ghost cursor-pointer has-[:focus-visible]:ring-2">Choose file<input class="sr-only" type="file" accept=".yaml,.yml,.json,application/json"></label>
        <span class="text-slate-500">· or write / paste below (max 5 MB)</span>
      </div>
      <label class="sr-only" for="spec-content">Spec content</label>
      <textarea id="spec-content" data-editor placeholder="Paste an OpenAPI 3.x / Swagger 2.0 document here (YAML or JSON), or click Starter above to begin from a template." class="field font-mono text-xs" name="content" rows="22" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off"><%= typeof content !== 'undefined' ? content : '' %></textarea>
      <%- include('spec-guide') %>
    </div>

    <div id="vp-preview" role="tabpanel" aria-labelledby="view-preview" hidden>
      <div class="mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <div role="group" aria-label="Preview size" class="inline-flex overflow-hidden rounded-lg border border-slate-300 text-sm font-medium dark:border-slate-700">
          <button type="button" data-device="desktop" aria-pressed="true" class="px-3 py-1.5 aria-pressed:bg-brand-600 aria-pressed:text-white">Desktop <span class="text-xs opacity-75">1440</span></button>
          <button type="button" data-device="tablet" aria-pressed="false" class="border-l border-slate-300 px-3 py-1.5 aria-pressed:bg-brand-600 aria-pressed:text-white dark:border-slate-700">Tablet <span class="text-xs opacity-75">768</span></button>
          <button type="button" data-device="phone" aria-pressed="false" class="border-l border-slate-300 px-3 py-1.5 aria-pressed:bg-brand-600 aria-pressed:text-white dark:border-slate-700">Phone <span class="text-xs opacity-75">390</span></button>
        </div>
        <div role="group" aria-label="Preview theme" class="inline-flex overflow-hidden rounded-lg border border-slate-300 text-sm font-medium dark:border-slate-700">
          <button type="button" data-pvtheme="auto" aria-pressed="true" class="px-3 py-1.5 aria-pressed:bg-brand-600 aria-pressed:text-white" title="Same as the page">Auto</button>
          <button type="button" data-pvtheme="light" aria-pressed="false" class="border-l border-slate-300 px-3 py-1.5 aria-pressed:bg-brand-600 aria-pressed:text-white dark:border-slate-700">Light</button>
          <button type="button" data-pvtheme="dark" aria-pressed="false" class="border-l border-slate-300 px-3 py-1.5 aria-pressed:bg-brand-600 aria-pressed:text-white dark:border-slate-700">Dark</button>
        </div>
        <span class="text-xs text-slate-600 dark:text-slate-400" id="pv-scale"></span>
        <p class="ml-auto text-sm text-slate-600 dark:text-slate-400" id="pv-hint" role="status" aria-live="polite"></p>
      </div>
      <p id="pv-empty" class="empty">Add valid content in the Edit tab, then render the preview.</p>
      <div id="pv-stage" class="hidden overflow-hidden rounded-lg border border-slate-200 bg-slate-100 dark:border-slate-700 dark:bg-slate-950">
        <div id="pv-pad" class="mx-auto overflow-hidden bg-white dark:bg-slate-900">
          <iframe name="bp-frame" id="bp-frame" title="Draft preview" class="block origin-top-left border-0 bg-white dark:bg-slate-900"></iframe>
        </div>
      </div>
    </div>

    <div id="vp-changes" role="tabpanel" aria-labelledby="view-changes" hidden>
      <div id="changes-body" class="text-sm"></div>
      <% if (bp) { %><label class="label mt-5">Change note (optional)<input class="field" name="note" maxlength="200" placeholder="What changed and why" data-note></label><% } %>
    </div>

    <div class="sticky bottom-0 -mx-5 -mb-5 mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-b-xl border-t border-slate-200 bg-white/95 px-5 py-3 backdrop-blur dark:border-slate-700 dark:bg-slate-900/95" data-bar>
      <div class="min-w-0 flex-1 basis-56 text-sm" id="bar-summary" aria-live="polite"><span class="text-slate-500">Add content to continue.</span></div>
      <a class="btn btn-text" href="/manage/blueprints" data-cancel>Cancel</a>
      <button type="button" class="btn btn-secondary" data-back hidden>← Back</button>
      <button type="button" class="btn" data-next disabled>Next: Preview →</button>
      <button class="btn" data-save data-busy="<%= bp ? 'Publishing…' : 'Adding…' %>" hidden><%= bp ? 'Publish changes' : 'Add blueprint' %></button>
    </div>
  </form>
</div>
<%- include('../partials/foot') %>
