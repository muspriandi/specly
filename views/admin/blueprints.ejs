<%- include('../partials/head') %>
<div class="mb-4 flex items-center justify-between"><h1 class="text-2xl font-bold">Blueprints</h1><a class="btn" href="/manage/blueprints/new">Add blueprint</a></div>
<%- include('../partials/list-search', { placeholder: 'Search blueprints by title', filter: filter }) %>
<div class="card overflow-x-auto !p-0">
<% if (!blueprints.length && filter) { %><div class="empty"><p>No blueprints match “<%= filter %>”.</p></div><% } else if (!blueprints.length) { %><div class="empty"><p>No blueprints yet. Upload an OpenAPI or Swagger file to publish your first API.</p><a class="btn" href="/manage/blueprints/new">Add blueprint</a></div><% } else { %>
<table id="tbl" class="w-full text-sm">
  <thead class="border-b border-slate-200 dark:border-slate-800"><tr><th scope="col" class="th">Title</th><th scope="col" class="th">Version</th><th scope="col" class="th">Format</th><th scope="col" class="th">Endpoints</th><th scope="col" class="th">Readers</th><th scope="col" class="th">Updated</th><th scope="col" class="th"><span class="sr-only">Actions</span></th></tr></thead>
  <% blueprints.forEach(function (b) { %>
  <tr class="tr">
    <td class="td"><a class="link" href="/blueprints/<%= b.id %>"><span class="clip" title="<%= b.title %>"><%= b.title %></span></a></td><td class="td"><%= b.version || '—' %></td>
    <td class="td"><span class="badge badge-neutral"><%= b.format.toUpperCase() %></span></td><td class="td"><%= b.endpoint_count %></td>
    <td class="td"><a class="link" href="/manage/blueprints/<%= b.id %>/access" title="Who can read this blueprint"><%= b.reader_count %></a></td>
    <td class="td text-xs text-slate-600 dark:text-slate-400"><%= fmt(b.updated_at) %></td>
    <td class="td"><div class="flex items-center justify-end gap-3">
      <a class="link" href="/manage/blueprints/<%= b.id %>/access">Access</a>
      <a class="link" href="/manage/blueprints/<%= b.id %>/versions">History</a>
      <a class="link" href="/manage/blueprints/<%= b.id %>/edit">Edit</a>
      <form method="post" action="/manage/blueprints/<%= b.id %>/delete" data-confirm="“<%= b.title %>”, will be hidden from everyone and its pending requests cancelled. You can restore it from the Trash." data-confirm-title="Move this blueprint to the trash?" data-confirm-action="Move to trash"><%- include('../partials/csrf') %><button class="link-danger">Delete</button></form>
    </div></td>
  </tr>
  <% }) %>
</table>
<% } %>
</div>
<%- include('../partials/pager', { pg: pg }) %>
<%- include('../partials/foot') %>
